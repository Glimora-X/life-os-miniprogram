.today-page .date-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.date-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  color: #3e4d35;
}

.date-num {
  font-size: 72rpx;
  font-weight: 600;
  line-height: 1;
}

.date-week {
  font-size: 36rpx;
  font-weight: 500;
}

.date-lunar {
  color: #8a867c;
  font-size: 26rpx;
}

.opening {
  margin-bottom: 48rpx;
}

.opening .page-title,
.opening .page-subtitle {
  display: block;
}

.thread {
  margin-bottom: 40rpx;
}

.thread-item {
  display: flex;
  gap: 28rpx;
  min-height: 168rpx;
}

.thread-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 48rpx;
  flex-shrink: 0;
}

.thread-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.thread-line {
  flex: 1;
  width: 2rpx;
  margin-top: 8rpx;
  background: rgba(62, 77, 53, 0.14);
}

.thread-icon-sun {
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
  box-shadow: 0 -12rpx 0 -3rpx #3e4d35, 0 12rpx 0 -3rpx #3e4d35;
}

.thread-icon-ring {
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
}

.thread-icon-cloud {
  width: 44rpx;
  height: 28rpx;
  border-radius: 20rpx;
  background: #b08d57;
}

.thread-icon-moon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
  box-shadow: 14rpx -4rpx 0 -10rpx #3e4d35;
}

.thread-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  padding-bottom: 44rpx;
}

.thread-period {
  color: #8a867c;
  font-size: 24rpx;
}

.thread-title {
  color: #2a2824;
  font-size: 32rpx;
  font-weight: 560;
  line-height: 1.4;
}

.thread-copy {
  color: #6f6a60;
  font-size: 28rpx;
  line-height: 1.55;
}

.closing {
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(62, 77, 53, 0.08);
}

.closing-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.closing-sun {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
  box-shadow: 0 -12rpx 0 -3rpx #3e4d35;
}

.closing-title {
  color: #2a2824;
  font-size: 36rpx;
  font-weight: 600;
}

.closing-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.closing-chip {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 14rpx;
  min-height: 72rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(62, 77, 53, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.8);
  color: #3e4d35;
  font-size: 28rpx;
}

.chip-icon-quote::before {
  color: #3e4d35;
  font-size: 28rpx;
  content: "“";
}

.chip-icon-check {
  width: 22rpx;
  height: 12rpx;
  border-bottom: 3rpx solid #3e4d35;
  border-left: 3rpx solid #3e4d35;
  transform: rotate(-45deg) translateY(-4rpx);
}

.chip-icon-leaf {
  width: 18rpx;
  height: 24rpx;
  border-radius: 50% 50% 40% 40%;
  background: #3e4d35;
  transform: rotate(-18deg);
}
