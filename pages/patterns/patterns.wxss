.patterns-page .header-copy {
  flex: 1;
}

.pattern-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 12rpx;
}

.hint-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid rgba(62, 77, 53, 0.25);
  border-radius: 50%;
  color: #8a867c;
  font-size: 22rpx;
  flex-shrink: 0;
}

.page-subtitle.inline {
  margin-top: 0;
}

.pattern-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pattern-card-main {
  display: flex;
  gap: 24rpx;
}

.pattern-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.pattern-icon-moon {
  border: 3rpx solid #b08d57;
  border-radius: 50%;
  box-shadow: 12rpx -6rpx 0 -8rpx #b08d57, 20rpx 4rpx 0 -12rpx rgba(176, 141, 87, 0.5);
}

.pattern-icon-walk {
  position: relative;
  border: 3rpx solid #3e4d35;
  border-radius: 50% 50% 8rpx 8rpx;
}

.pattern-icon-walk::after {
  position: absolute;
  right: -8rpx;
  bottom: 4rpx;
  width: 20rpx;
  height: 3rpx;
  background: #3e4d35;
  transform: rotate(-25deg);
  content: "";
}

.pattern-icon-sleep {
  position: relative;
  border: 3rpx solid #3e4d35;
  border-radius: 8rpx;
}

.pattern-icon-sleep::before {
  position: absolute;
  margin: 12rpx 0 0 16rpx;
  color: #b08d57;
  font-size: 20rpx;
  content: "★";
}

.pattern-icon-pen {
  border-bottom: 3rpx solid #b08d57;
  transform: rotate(-35deg);
}

.pattern-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.pattern-statement {
  color: #2a2824;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.pattern-evidence {
  color: #6f6a60;
  font-size: 28rpx;
  line-height: 1.55;
}

.pattern-link {
  margin-top: 8rpx;
  color: #8a867c;
  font-size: 24rpx;
}

.pattern-return {
  margin-top: 40rpx;
}

.return-label {
  display: block;
  margin-bottom: 20rpx;
  color: #3e4d35;
  font-size: 30rpx;
  font-weight: 560;
}

.return-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
}

.return-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(62, 77, 53, 0.1);
  flex-shrink: 0;
}

.return-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.return-title {
  color: #2a2824;
  font-size: 30rpx;
  font-weight: 560;
  line-height: 1.4;
}

.return-body {
  color: #6f6a60;
  font-size: 26rpx;
  line-height: 1.5;
}

.return-go {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #3e4d35;
  color: #f9f8f3;
  font-size: 36rpx;
  flex-shrink: 0;
}
