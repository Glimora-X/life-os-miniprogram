.self-page .page-header {
  align-items: center;
}

.self-page .page-title {
  flex: 1;
}

.profile-card {
  margin-bottom: 28rpx;
}

.profile-main {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 2rpx solid rgba(62, 77, 53, 0.1);
}

.avatar-landscape {
  width: 100%;
  height: 100%;
  background:
    linear-gradient(180deg, #c8d4c0 0%, #8fa888 42%, #6b8f72 100%);
}

.profile-name {
  display: block;
  color: #2a2824;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
}

.profile-practice {
  display: block;
  margin-top: 10rpx;
  color: #6f6a60;
  font-size: 28rpx;
  line-height: 1.5;
}

.section-card {
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #2a2824;
  font-size: 32rpx;
  font-weight: 560;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.vocab-tag {
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(62, 77, 53, 0.08);
  color: #3e4d35;
  font-size: 26rpx;
}

.pattern-bullets {
  color: #4a4640;
  font-size: 28rpx;
  line-height: 1.6;
}

.aspiration-text {
  color: #4a4640;
  font-size: 28rpx;
  line-height: 1.6;
}

.pref-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 32rpx;
}

.pref-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #4a4640;
  font-size: 28rpx;
}

.pref-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #3e4d35;
  border-radius: 8rpx;
}

.pref-icon-list {
  border-radius: 4rpx;
}

.pref-icon-list::before,
.pref-icon-list::after {
  display: block;
  height: 4rpx;
  margin: 8rpx 6rpx;
  background: #3e4d35;
  content: "";
}

.pref-icon-clock {
  border-radius: 50%;
}

.fingerprint-card {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 36rpx;
}

.fingerprint-icon {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 30% 30%, transparent 8rpx, rgba(62, 77, 53, 0.15) 9rpx, transparent 10rpx),
    radial-gradient(circle at 55% 40%, transparent 6rpx, rgba(62, 77, 53, 0.12) 7rpx, transparent 8rpx),
    rgba(62, 77, 53, 0.06);
  border: 1rpx solid rgba(62, 77, 53, 0.12);
}

.fingerprint-copy {
  flex: 1;
}

.fingerprint-text {
  display: block;
  margin-top: 16rpx;
  color: #6f6a60;
  font-size: 26rpx;
  line-height: 1.55;
}

.section-icon-chart::before,
.section-icon-chart::after {
  display: inline-block;
  width: 8rpx;
  margin-right: 4rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: #3e4d35;
  content: "";
}

.section-icon-chart::before {
  height: 16rpx;
}

.section-icon-chart::after {
  height: 24rpx;
}

.section-icon-person {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #3e4d35;
  border-radius: 50% 50% 6rpx 6rpx;
}

.section-icon-pen {
  width: 28rpx;
  height: 3rpx;
  background: #3e4d35;
  transform: rotate(-30deg);
}

.settings-list {
  border-top: 1rpx solid rgba(62, 77, 53, 0.08);
}

.settings-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid rgba(62, 77, 53, 0.06);
  color: #2a2824;
  font-size: 30rpx;
}

.settings-row text:first-of-type {
  flex: 1;
}

.settings-arrow {
  color: #8a867c;
  font-size: 40rpx;
}

.settings-icon {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #8a867c;
  border-radius: 50%;
  opacity: 0.7;
}

.settings-icon-palette {
  border-radius: 8rpx;
}
