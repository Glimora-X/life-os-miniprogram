.echoes-page .header-copy {
  flex: 1;
}

.echo-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.echo-card-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.echo-card-head .icon-badge {
  flex-shrink: 0;
}

.echo-head-text {
  flex: 1;
  min-width: 0;
}

.echo-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.echo-card-title {
  flex: 1;
  color: #2a2824;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.echo-card-time {
  flex-shrink: 0;
  color: #8a867c;
  font-size: 22rpx;
  line-height: 1.4;
}

.echo-lines {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.echo-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.echo-line-text {
  flex: 1;
  color: #4a4640;
  font-size: 28rpx;
  line-height: 1.5;
}

.echo-line-time {
  flex-shrink: 0;
  color: #8a867c;
  font-size: 24rpx;
}

.resurface-card {
  padding-bottom: 40rpx;
}

.resurface-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.resurface-title {
  flex: 1;
  color: #2a2824;
  font-size: 32rpx;
  font-weight: 560;
  line-height: 1.4;
}

.resurface-action {
  color: #3e4d35;
  font-size: 26rpx;
  font-weight: 560;
}

.resurface-quote {
  display: block;
  color: #2a2824;
  font-size: 36rpx;
  line-height: 1.45;
  text-align: center;
}

.resurface-caption {
  display: block;
  margin-top: 20rpx;
  color: #6f6a60;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.resurface-date {
  display: block;
  margin-top: 28rpx;
  color: #8a867c;
  font-size: 24rpx;
  text-align: right;
}
