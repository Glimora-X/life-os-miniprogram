.sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.sheet-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(42, 40, 36, 0.28);
}

.sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: 0 -20rpx 64rpx rgba(42, 40, 36, 0.14);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 28rpx;
  border-radius: 999rpx;
  background: rgba(42, 40, 36, 0.12);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.sheet-title {
  color: #2a2824;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(42, 40, 36, 0.06);
  color: #6f6a60;
  font-size: 40rpx;
  line-height: 1;
}

.capture-input-wrap {
  position: relative;
}

.capture-input {
  width: 100%;
  min-height: 200rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #f3f0e8;
  color: #2a2824;
  font-size: 32rpx;
  line-height: 1.55;
}

.input-decor {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  width: 48rpx;
  height: 60rpx;
  border-radius: 50% 50% 40% 40%;
  background: rgba(62, 77, 53, 0.08);
  transform: rotate(-18deg);
  pointer-events: none;
}

.intent-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.intent-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-height: 128rpx;
  padding: 20rpx 8rpx;
  border: 1rpx solid rgba(62, 77, 53, 0.14);
  border-radius: 20rpx;
  background: rgba(255, 253, 248, 0.9);
  color: #4a4640;
  font-size: 24rpx;
}

.intent-tile-active {
  border-color: rgba(62, 77, 53, 0.35);
  background: rgba(62, 77, 53, 0.08);
  color: #3e4d35;
  font-weight: 560;
}

.intent-icon-leaf {
  width: 28rpx;
  height: 36rpx;
  border-radius: 50% 50% 40% 40%;
  background: #3e4d35;
  transform: rotate(-18deg);
}

.intent-icon-wave {
  width: 36rpx;
  height: 16rpx;
  border-bottom: 3rpx solid #3e4d35;
  border-radius: 0 0 50% 50%;
}

.intent-icon-clock {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
}

.intent-icon-cloud {
  width: 40rpx;
  height: 24rpx;
  border-radius: 18rpx;
  background: rgba(62, 77, 53, 0.25);
}

.voice-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: rgba(42, 40, 36, 0.06);
}

.voice-mic {
  width: 28rpx;
  height: 36rpx;
  border: 3rpx solid #6f6a60;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
}

.voice-text {
  flex: 1;
  color: #6f6a60;
  font-size: 28rpx;
}

.voice-wave {
  display: flex;
  gap: 4rpx;
  align-items: flex-end;
}

.voice-wave::before,
.voice-wave::after {
  display: block;
  width: 4rpx;
  background: #8a867c;
  border-radius: 2rpx;
  content: "";
}

.voice-wave::before {
  height: 16rpx;
}

.voice-wave::after {
  height: 28rpx;
}

.sheet-note {
  display: block;
  margin-top: 28rpx;
  color: #8a867c;
  font-size: 24rpx;
  text-align: center;
}

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
}

.secondary-btn,
.save-btn {
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
}

.secondary-btn {
  flex: 0 0 200rpx;
  background: transparent;
  color: #6f6a60;
}

.save-btn {
  flex: 1;
  background: #3e4d35;
  color: #f9f8f3;
  font-weight: 560;
}
