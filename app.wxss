page {
  min-height: 100vh;
  background: #f9f8f3;
  color: #2a2824;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: normal;
  color: inherit;
}

button::after {
  border: 0;
}

.serif {
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.page {
  min-height: 100vh;
  padding: calc(88rpx + env(safe-area-inset-top)) 40rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f9f8f3;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.leaf-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.9);
  border: 1rpx solid rgba(62, 77, 53, 0.1);
  box-shadow: 0 8rpx 24rpx rgba(42, 40, 36, 0.06);
}

.leaf-btn-mark {
  position: relative;
  width: 22rpx;
  height: 28rpx;
  border-radius: 50% 50% 40% 40%;
  background: #3e4d35;
  transform: rotate(-18deg);
}

.page-title {
  display: block;
  color: #2a2824;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.15;
}

.page-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #6f6a60;
  font-size: 28rpx;
  line-height: 1.55;
}

.quiet-label {
  color: #8a867c;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  position: relative;
  overflow: hidden;
  padding: 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(62, 77, 53, 0.06);
  box-shadow: 0 12rpx 40rpx rgba(42, 40, 36, 0.05);
}

.card-decor {
  position: absolute;
  right: -20rpx;
  bottom: -20rpx;
  width: 220rpx;
  height: 160rpx;
  opacity: 0.35;
  pointer-events: none;
}

.card-decor-leaves {
  background:
    radial-gradient(circle at 70% 80%, rgba(62, 77, 53, 0.22), transparent 58%),
    radial-gradient(circle at 40% 60%, rgba(176, 141, 87, 0.18), transparent 52%);
}

.card-decor-lake {
  background:
    linear-gradient(180deg, transparent 40%, rgba(62, 77, 53, 0.12) 100%),
    radial-gradient(ellipse at 60% 90%, rgba(176, 141, 87, 0.2), transparent 60%);
}

.card-decor-path {
  background:
    radial-gradient(circle at 80% 70%, rgba(176, 141, 87, 0.16), transparent 55%),
    linear-gradient(135deg, transparent 30%, rgba(62, 77, 53, 0.1) 100%);
}

.card-decor-moon {
  background:
    radial-gradient(circle at 20% 50%, rgba(176, 141, 87, 0.25), transparent 45%),
    radial-gradient(circle at 35% 45%, rgba(62, 77, 53, 0.08), transparent 30%);
}

.icon-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(62, 77, 53, 0.1);
}

.icon-badge-warm {
  background: rgba(176, 141, 87, 0.16);
}

.icon-sun::before {
  display: block;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #3e4d35;
  border-radius: 50%;
  box-shadow: 0 -14rpx 0 -4rpx #3e4d35, 0 14rpx 0 -4rpx #3e4d35, 14rpx 0 0 -4rpx #3e4d35, -14rpx 0 0 -4rpx #3e4d35;
  content: "";
}

.icon-quote::before {
  color: #3e4d35;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  content: "”";
}

.icon-leaf-small {
  width: 18rpx;
  height: 24rpx;
  border-radius: 50% 50% 40% 40%;
  background: #3e4d35;
  transform: rotate(-20deg);
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #3e4d35;
  color: #f9f8f3;
  font-size: 30rpx;
  font-weight: 560;
}

.script-note {
  font-family: "Snell Roundhand", "Bradley Hand", "Kaiti SC", "STKaiti", cursive;
  font-size: 28rpx;
  line-height: 1.4;
}

.script-note-green {
  color: #3e4d35;
}

.script-note-warm {
  color: #b08d57;
}
