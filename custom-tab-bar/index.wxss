.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  padding: 0 24rpx;
  background: rgba(249, 248, 243, 0.92);
  backdrop-filter: blur(12px);
  border-top: 1rpx solid rgba(62, 77, 53, 0.08);
}

.tab-bar-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 12rpx 8rpx 8rpx;
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.tab-label {
  color: #8a867c;
  font-size: 22rpx;
  line-height: 1.2;
}

.tab-item-active .tab-label {
  color: #3e4d35;
  font-weight: 560;
}

.tab-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #3e4d35;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.55;
}

.tab-icon-active {
  opacity: 1;
}

.tab-icon-today {
  border: 3rpx solid #8a867c;
  border-radius: 50%;
  box-shadow: inset 0 -8rpx 0 #8a867c;
}

.tab-icon-today.tab-icon-active {
  border-color: #3e4d35;
  box-shadow: inset 0 -8rpx 0 #3e4d35;
}

.tab-icon-echoes {
  border: 3rpx solid #8a867c;
  border-radius: 18rpx 18rpx 6rpx 6rpx;
}

.tab-icon-echoes.tab-icon-active {
  border-color: #3e4d35;
  background: rgba(62, 77, 53, 0.12);
}

.tab-icon-patterns {
  position: relative;
}

.tab-icon-patterns::before,
.tab-icon-patterns::after {
  position: absolute;
  bottom: 8rpx;
  width: 10rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #8a867c;
  content: "";
}

.tab-icon-patterns::before {
  left: 8rpx;
  height: 18rpx;
}

.tab-icon-patterns::after {
  right: 8rpx;
  height: 28rpx;
}

.tab-icon-patterns.tab-icon-active::before,
.tab-icon-patterns.tab-icon-active::after {
  background: #3e4d35;
}

.tab-icon-self {
  border: 3rpx solid #8a867c;
  border-radius: 50% 50% 8rpx 8rpx;
}

.tab-icon-self.tab-icon-active {
  border-color: #3e4d35;
}

.tab-capture {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin: -36rpx 12rpx 0;
  border-radius: 54rpx;
  background: #3e4d35;
  box-shadow: 0 16rpx 36rpx rgba(62, 77, 53, 0.28);
}

.tab-capture-plus {
  color: #f9f8f3;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

.tab-safe {
  height: env(safe-area-inset-bottom);
}
